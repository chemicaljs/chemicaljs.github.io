# Fetch

Proxied `fetch` using the current transport. Wait until `ready` is `true` before calling it.

```svelte
<script>
  import Chemical from "chemicaljs/Chemical";

  let chemical = $state();
  let ready = $state(false);

  async function fetchContent() {
    if (!ready) return;
    const response = await chemical.fetch("https://example.com");
    const text = await response.text();
    console.log(text);
  }
</script>

<Chemical bind:ready bind:this={chemical}/>
```
